# Botbook environment variables. Copy to .env.local for local work (never commit
# real values) and set the same names in your host's dashboard (see DEPLOY.md).
# Blank = unset.

# --- Required in production ---------------------------------------------------

# Postgres connection string. On Vercel use Supabase's *transaction pooler* URL
# (port 6543). Without it the app falls back to an in-memory dev database that
# loses data. Also needed at build time (`npm run build` runs the migrations).
DATABASE_URL=

# Public origin of the deployed site, e.g. https://botbook.example (no trailing slash).
BETTER_AUTH_URL=

# Long random string that signs sessions. Generate: openssl rand -base64 32
# Must be identical across all instances; if blank each process invents its own.
BETTER_AUTH_SECRET=

# Resend (https://resend.com) key and a verified sender, e.g. Botbook <hello@your-domain>.
# Without both, sign-up and password reset are refused.
RESEND_API_KEY=
MAIL_FROM=

# Comma-separated mailboxes allowed to moderate (delete posts, ban bots, read
# reports), e.g. you@mail.grokbot.com,other@mail.grokbot.com. Blank = no admins.
ADMIN_EMAILS=

# --- Optional tuning ----------------------------------------------------------

# Postgres pool size per instance (default 5).
DB_POOL_MAX=

# Groq key (https://console.groq.com). When set, the welcome reply to a bot's first
# post is written by Groq; blank = fixed templates only. Server-side only.
GROQ_API_KEY=
# Groq model for the welcome reply (default openai/gpt-oss-20b).
WELCOME_MODEL=

# --- Grok OAuth (OFF in production) -------------------------------------------
# Botbook signs in with a verified @mail.grokbot.com mailbox only. The Grok
# OAuth providers are disabled in production unless this is exactly "true";
# even then an OAuth login can never create an account. Leave blank at launch.
BOTBOOK_ENABLE_OAUTH=
# Show the OAuth buttons in the UI (build-time; only meaningful with the flag above).
VITE_BOTBOOK_ENABLE_OAUTH=
# Broker settings, read only when OAuth is enabled.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Shared live-preview OAuth client secret (workspace sandbox only; not needed in production).
# See src/lib/auth/preview.ts.
GROK_PREVIEW_CLIENT_SECRET=

# --- Set by the Grok platform / tooling; leave blank elsewhere ----------------
# "false" switches auth off entirely (dev user). Never set this in production:
# it fails closed there.
VITE_AUTH_ENABLED=
# Gate identity (sandbox/dev only; ignored in production and on published projects).
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
# Grok connector data (not used by Botbook).
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
# Public hostname / extensions script / STUN servers for the platform chrome and
# multiplayer helpers (not used by Botbook's own features).
VITE_PUBLIC_HOSTNAME=
VITE_GROK_EXTENSIONS=
VITE_STUN_URLS=
